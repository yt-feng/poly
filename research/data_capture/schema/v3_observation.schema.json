{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yt-feng/poly_trade/schema/v3-observation.json",
  "title": "Validated v3 public market observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "source_event_time_ms", "received_time_ms", "market_id", "condition_id", "token_ids", "observation_type", "fees", "rules", "provenance"],
  "properties": {
    "schema_version": {"const": 3},
    "observation_id": {"type": "string", "minLength": 1},
    "source_event_time_ms": {"type": "integer", "minimum": 1},
    "received_time_ms": {"type": "integer", "minimum": 1},
    "market_id": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "token_ids": {"type": "object", "additionalProperties": false, "required": ["up", "down"], "properties": {"up": {"type": "string", "minLength": 1}, "down": {"type": "string", "minLength": 1}}},
    "observation_type": {"enum": ["book_snapshot", "trade"]},
    "fees": {"type": "object", "additionalProperties": false, "required": ["rate", "exponent", "asset"], "properties": {"rate": {"type": "number", "minimum": 0}, "exponent": {"type": "number", "minimum": 0}, "asset": {"type": "string", "minLength": 1}}},
    "rules": {"type": "object", "additionalProperties": false, "required": ["tick_size", "min_order_size"], "properties": {"tick_size": {"type": "number", "exclusiveMinimum": 0}, "min_order_size": {"type": "number", "exclusiveMinimum": 0}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "capture_id", "source_sha256", "retrieved_at_ms"], "properties": {"source": {"type": "string", "minLength": 1}, "capture_id": {"type": "string", "minLength": 1}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "retrieved_at_ms": {"type": "integer", "minimum": 1}}},
    "books": {"type": "object", "additionalProperties": false, "required": ["up", "down"], "properties": {"up": {"$ref": "#/$defs/book"}, "down": {"$ref": "#/$defs/book"}}},
    "trade": {"type": "object", "additionalProperties": false, "required": ["trade_id", "price", "size", "side"], "properties": {"trade_id": {"type": "string", "minLength": 1}, "price": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "size": {"type": "number", "exclusiveMinimum": 0}, "side": {"enum": ["buy", "sell"]}}}
  },
  "$defs": {"level": {"type": "object", "additionalProperties": false, "required": ["level", "price", "size"], "properties": {"level": {"type": "integer", "minimum": 0}, "price": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "size": {"type": "number", "minimum": 0}}}, "book": {"type": "object", "additionalProperties": false, "required": ["bids", "asks"], "properties": {"bids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}}, "asks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}}}}}
}
